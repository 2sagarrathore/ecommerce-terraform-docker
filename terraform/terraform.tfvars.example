# Copy to terraform.tfvars and edit before running `terraform apply`.

# Required: the Docker Hub account that holds the five pushed images.
dockerhub_username = "your-dockerhub-username"

# Optional overrides.
aws_region    = "ap-south-1"
instance_type = "t3.micro"
image_tag     = "1.0.0"

# Lock the frontend down to your own IP instead of the whole internet.
# allowed_http_cidr = "203.0.113.4/32"

# Enable SSH access (both values are needed).
# key_pair_name    = "my-ec2-keypair"
# allowed_ssh_cidr = "203.0.113.4/32"

# Only needed if the Docker Hub repositories are private.
# dockerhub_token = "dckr_pat_xxxxxxxx"
